{
  "schema_version": 2,
  "id": "demo_cv",
  "description": "Synthetic CV parameter example",
  "notes": [
    "Parameter planning only; no measurement data or hardware execution."
  ],
  "steps": [
    {
      "device": "electrochemical_station",
      "operation": "measure",
      "technique": "cyclic_voltammetry",
      "parameters": {
        "initial_potential_v": 0,
        "upper_potential_v": 0.5,
        "lower_potential_v": -0.5,
        "final_potential_v": 0,
        "initial_scan_direction": "positive",
        "scan_rate_v_s": 0.1,
        "potential_step_v": 0.001,
        "cycles": 1,
        "quiet_time_s": 5,
        "current_range_a": null,
        "reference_electrode": "unspecified"
      }
    }
  ],
  "preflight": {
    "type": "preflight",
    "id": "experiment_preparation",
    "description": "Home the syringe when used, drain the cell and confirm it is empty",
    "steps": [
      {
        "device": "syringe_c",
        "operation": "home_if_used"
      },
      {
        "device": "cell",
        "operation": "drain_to_waste",
        "route": "waste_1"
      },
      {
        "device": "cell",
        "operation": "confirm_empty"
      }
    ]
  }
}
