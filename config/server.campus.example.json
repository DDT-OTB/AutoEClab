{
  "host": "127.0.0.1",
  "port": 8765,
  "lab_root": "/opt/autoeclab-instruments",
  "static_root": "../frontend/dist",
  "hardware_execution_enabled": false,
  "electrochemical_station": {
    "enabled": false,
    "port": "",
    "max_potential_v": 3,
    "max_cycles": 499,
    "dac_reference_mv": 120,
    "step_time_unit_ns": 1000,
    "timing_verified": false
  },
  "automation": {
    "prepare_ttl_seconds": 600
  },
  "authentication": {
    "enabled": true,
    "transport": "https_reverse_proxy",
    "idle_timeout_seconds": 1800,
    "absolute_timeout_seconds": 28800,
    "login_window_seconds": 900,
    "login_max_failures": 8
  },
  "access": {
    "https_origins": [
      "https://192.0.2.10"
    ],
    "trusted_proxy_addresses": [
      "127.0.0.1"
    ],
    "allow_ssh_loopback": true
  },
  "status_mode": "controller_events",
  "device_status": {
    "enabled": false,
    "cache_ttl_seconds": 30,
    "min_interval_seconds": 3,
    "timeout_seconds": 10
  },
  "monitoring": {
    "push_interval_seconds": 1,
    "stale_after_seconds": 15
  },
  "fluidic_topology": "syringe_inlet_selector"
}
