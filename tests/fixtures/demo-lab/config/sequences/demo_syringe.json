{
  "schema_version": 2,
  "id": "demo_syringe",
  "description": "Synthetic syringe action example",
  "notes": [
    "Artificial test input."
  ],
  "steps": [
    {
      "device": "syringe_c",
      "operation": "inject",
      "volume_ml": 1.0,
      "fluid": "electrolyte"
    }
  ],
  "preflight": {
    "type": "preflight",
    "id": "experiment_preparation",
    "description": "Home the syringe when used, drain the cell and confirm it is empty",
    "steps": [
      {
        "device": "valve",
        "operation": "select_syringe_water_if_used",
        "route": "water"
      },
      {
        "device": "syringe_c",
        "operation": "home_if_used"
      },
      {
        "device": "cell",
        "operation": "drain_to_waste",
        "route": "waste_1"
      },
      {
        "device": "cell",
        "operation": "confirm_empty"
      }
    ]
  }
}
