{
  "schema_version": 2,
  "id": "demo_rinse",
  "description": "Synthetic workflow for automated tests",
  "notes": [
    "All volumes and flow values are artificial test inputs."
  ],
  "steps": [
    {
      "device": "peristaltic_1",
      "operation": "inject",
      "volume_ml": 1.0,
      "fluid": "water"
    },
    {
      "device": "valve",
      "operation": "switch_route",
      "route": "waste_1"
    },
    {
      "device": "peristaltic_2",
      "operation": "withdraw",
      "volume_ml": 1.0,
      "fluid": "waste_liquid"
    },
    {
      "device": "syringe_c",
      "operation": "inject",
      "volume_ml": 2.0,
      "fluid": "electrolyte"
    },
    {
      "device": "valve",
      "operation": "switch_route",
      "route": "waste_2"
    },
    {
      "device": "peristaltic_2",
      "operation": "withdraw",
      "volume_ml": 2.0,
      "fluid": "waste_liquid"
    },
    {
      "device": "peristaltic_1",
      "operation": "inject",
      "volume_ml": 1.0,
      "fluid": "water"
    },
    {
      "device": "valve",
      "operation": "switch_route",
      "route": "waste_1"
    },
    {
      "device": "peristaltic_2",
      "operation": "withdraw",
      "volume_ml": 1.0,
      "fluid": "waste_liquid"
    }
  ],
  "preflight": {
    "type": "preflight",
    "id": "experiment_preparation",
    "description": "Home the syringe when used, drain the cell and confirm it is empty",
    "steps": [
      {
        "device": "syringe_c",
        "operation": "home_if_used"
      },
      {
        "device": "cell",
        "operation": "drain_to_waste",
        "route": "waste_1"
      },
      {
        "device": "cell",
        "operation": "confirm_empty"
      }
    ]
  }
}
